# Leave -- production settings. Copy to .env on the server; never commit .env.

# --- Server ------------------------------------------------------------------
BASE_URL=https://leave.example.org
# LISTEN_ADDR=:8080
# DB_PATH=/data/leave.db               # set by the image
# COOKIE_SECURE=true                   # false only for plain-http local development
# SESSION_TTL=8h                       # idle timeout; slides with use
# TRUSTED_PROXIES=172.18.0.0/16        # the reverse proxy's network, so rate limits see real client IPs
# TZ_NAME=Africa/Johannesburg

# The image to run (compose.yaml); pin to a commit so a rollback is one line.
TAG=latest

# --- Directory (Active Directory over LDAPS) ---------------------------------
DIRECTORY=ldap
LDAP_URL=ldaps://dc1.example.local:636
# A read-only service account: it finds people and reads group membership.
# It never checks anyone's password -- that is a bind as the person themselves.
LDAP_BIND_DN=CN=svc-leave,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=OU=Staff,DC=example,DC=local
# Members (including nested) administer the app.
LDAP_ADMIN_GROUP=CN=Leave Admins,OU=Groups,DC=example,DC=local
# The OU holding the AD groups that are volunteer teams (each group is a team,
# nested groups count). Unset turns teams off: no team limits, no team sync.
# LDAP_TEAMS_BASE_DN=OU=Teams,OU=Groups,DC=example,DC=local
# PEM bundle for the internal CA that signed the DC's certificate, mounted into
# the container. Empty uses the system roots.
# LDAP_CA_FILE=/certs/internal-ca.pem
# Enabled people only by default; narrow it further if needed.
# LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
# DIRECTORY_SYNC_INTERVAL=1h

# Leave policy -- the working week, the restricted day, the final approver and
# the sick-leave rules -- is not set here. An admin edits it on Admin -> Settings.

# --- Microsoft Graph (mail + shared calendar) ---------------------------------
# One app registration, client credentials. Application permissions, admin
# consented: Mail.Send and Calendars.ReadWrite -- both restricted to the two
# mailboxes below with RBAC for Applications / an application access policy.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The mailbox notifications are sent as.
EMAIL_FROM=leave@example.org
# The mailbox whose calendar holds approved leave (a shared mailbox is ideal),
# and optionally a calendar inside it other than the default.
LEAVE_CALENDAR_MAILBOX=leave@example.org
# LEAVE_CALENDAR_ID=
