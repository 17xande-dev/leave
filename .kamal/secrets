# Kamal reads this file for the secrets named in config/deploy.yml. It holds no
# literal secrets, so it is committed: values come from the gitignored .env beside
# config/ (the single secrets mechanism across these repos). Run kamal from the
# repo root.
KAMAL_REGISTRY_PASSWORD=$(gh auth token)
LDAP_URL=$(grep '^LDAP_URL=' .env | cut -d= -f2-)
LDAP_BIND_DN=$(grep '^LDAP_BIND_DN=' .env | cut -d= -f2-)
LDAP_BIND_PASSWORD=$(grep '^LDAP_BIND_PASSWORD=' .env | cut -d= -f2-)
LDAP_BASE_DN=$(grep '^LDAP_BASE_DN=' .env | cut -d= -f2-)
LDAP_USER_FILTER=$(grep '^LDAP_USER_FILTER=' .env | cut -d= -f2-)
LDAP_ADMIN_GROUP=$(grep '^LDAP_ADMIN_GROUP=' .env | cut -d= -f2-)
LDAP_CA_FILE=$(grep '^LDAP_CA_FILE=' .env | cut -d= -f2-)
GRAPH_TENANT_ID=$(grep '^GRAPH_TENANT_ID=' .env | cut -d= -f2-)
GRAPH_CLIENT_ID=$(grep '^GRAPH_CLIENT_ID=' .env | cut -d= -f2-)
GRAPH_CLIENT_SECRET=$(grep '^GRAPH_CLIENT_SECRET=' .env | cut -d= -f2-)
EMAIL_FROM=$(grep '^EMAIL_FROM=' .env | cut -d= -f2-)
LEAVE_CALENDAR_MAILBOX=$(grep '^LEAVE_CALENDAR_MAILBOX=' .env | cut -d= -f2-)
