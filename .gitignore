# The database holds staff names and leave history -- never commit it,
# wherever DB_PATH points. Includes the WAL/SHM sidecars.
/data/
*.db
*.db-wal
*.db-shm
*.migrate-lock

# Secrets
.env

/bin/*
!/bin/check-env

# Internal CA certificates for LDAPS, bind-mounted by config/deploy.yml: the server's, not the repo's.
/certs/

